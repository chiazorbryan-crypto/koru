{
  "name": "koru",
  "version": "1.2.1",
  "description": "Koru — a personal manga and manhwa reader",
  "type": "module",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "app.koru.reader",
    "productName": "Koru",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "build/icon.ico",
      "package.json",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle",
      "!node_modules/node-llama-cpp/llama/llama.cpp/**",
      "!node_modules/node-llama-cpp/llama/localBuilds/**",
      "!node_modules/node-llama-cpp/templates/**",
      "!node_modules/@node-llama-cpp/!(win-x64)/**",
      "!node_modules/**/*.{d.ts,map,md,lib,h}",
      "!node_modules/**/yarn.lock",
      "!web/kitsunet/golden.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Koru",
      "artifactName": "Koru-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "publish": null,
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": "build/koru-taskbar.exe",
        "to": "koru-taskbar.exe"
      },
      {
        "from": "build/koru-media.exe",
        "to": "koru-media.exe"
      }
    ],
    "afterPack": "build/after-pack.cjs",
    "asarUnpack": [
      "node_modules/@node-llama-cpp/win-x64/**",
      "node_modules/node-llama-cpp/bins/**"
    ]
  },
  "dependencies": {
    "@node-llama-cpp/win-x64": "3.22.3",
    "node-llama-cpp": "3.22.3"
  }
}
